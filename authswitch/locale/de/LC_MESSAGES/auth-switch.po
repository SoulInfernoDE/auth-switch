#: authswitch/__main__.py:15
msgid "Switch between Proxmox VE accounts."
msgstr "Zwischen Proxmox-VE-Konten wechseln."

#: authswitch/__main__.py:18
msgid "open the window (default)"
msgstr "Fenster öffnen (Standard)"

#: authswitch/__main__.py:19
msgid "print the accounts as JSON"
msgstr "Konten als JSON ausgeben"

#: authswitch/__main__.py:20
msgid "activate an account"
msgstr "ein Konto aktivieren"

#: authswitch/__main__.py:23
msgid "run a command with the active account in its environment"
msgstr "einen Befehl mit dem aktiven Konto in seiner Umgebung ausführen"

#: authswitch/__main__.py:26
msgid "check files or a git working copy for private data"
msgstr "Dateien oder eine Git-Arbeitskopie auf private Daten prüfen"

#: authswitch/__main__.py:28
msgid "check what the next push of this working copy would publish"
msgstr "prüfen, was der nächste Push dieser Arbeitskopie veröffentlichen würde"

#: authswitch/__main__.py:29
msgid "run the MCP server on stdio"
msgstr "MCP-Server über stdio starten"

#: authswitch/__main__.py:40
msgid "exec needs a command, for example: auth-switch exec -- terraform plan"
msgstr ""
"exec braucht einen Befehl, zum Beispiel: auth-switch exec -- terraform plan"

#: authswitch/__main__.py:50
#, python-brace-format
msgid "auth-switch: {error}"
msgstr "auth-switch: {error}"

#: authswitch/__main__.py:68
msgid "No private data found."
msgstr "Keine privaten Daten gefunden."

#: authswitch/__main__.py:68
#, python-brace-format
msgid "{count} finding(s)."
msgstr "{count} Fund(e)."

#: authswitch/core.py:162
msgid ""
"No system keyring is available (libsecret is missing), so the secret cannot "
"be stored safely."
msgstr ""
"Kein System-Schlüsselbund verfügbar (libsecret fehlt), das Geheimnis kann "
"daher nicht sicher gespeichert werden."

#: authswitch/core.py:174
#, python-brace-format
msgid "The system keyring refused the request: {detail}"
msgstr "Der System-Schlüsselbund hat die Anfrage abgelehnt: {detail}"

#: authswitch/core.py:185
msgid "The secret could not be stored in the system keyring."
msgstr "Das Geheimnis konnte nicht im System-Schlüsselbund gespeichert werden."

#: authswitch/core.py:216 authswitch/core.py:230 authswitch/core.py:319
#, python-brace-format
msgid "{host} cannot be reached: {detail}"
msgstr "{host} ist nicht erreichbar: {detail}"

#: authswitch/core.py:256
#, python-brace-format
msgid ""
"The certificate of {host} is not the one you confirmed. Nothing was sent. If "
"the server got a new certificate, add the account again to confirm it."
msgstr ""
"Das Zertifikat von {host} ist nicht das, das du bestätigt hast. Es wurde "
"nichts gesendet. Falls der Server ein neues Zertifikat hat, füge das Konto "
"erneut hinzu, um es zu bestätigen."

#: authswitch/core.py:279
msgid "The path must start with a single / and stay below /api2/json."
msgstr ""
"Der Pfad muss mit genau einem / beginnen und unterhalb von /api2/json "
"bleiben."

#: authswitch/core.py:281
msgid "Endpoints that issue tickets or credentials are not available here."
msgstr ""
"Endpunkte, die Tickets oder Zugangsdaten ausstellen, stehen hier nicht zur "
"Verfügung."

#: authswitch/core.py:296 authswitch/mcp.py:174
#, python-brace-format
msgid "Unsupported method: {method}"
msgstr "Nicht unterstützte Methode: {method}"

#: authswitch/core.py:316
#, python-brace-format
msgid ""
"The certificate of {host} is not trusted; add the account again to confirm "
"it."
msgstr ""
"Dem Zertifikat von {host} wird nicht vertraut; füge das Konto erneut hinzu, "
"um es zu bestätigen."

#: authswitch/core.py:362
msgid ""
"The token ID must look like user@realm!name, for example root@pam!auth-"
"switch."
msgstr ""
"Die Token-ID muss die Form benutzer@realm!name haben, zum Beispiel root@pam!"
"auth-switch."

#: authswitch/core.py:365
#, python-brace-format
msgid "{host} rejected the token."
msgstr "{host} hat das Token abgelehnt."

#: authswitch/core.py:367
#, python-brace-format
msgid "{host} did not answer like a Proxmox VE server."
msgstr "{host} hat nicht wie ein Proxmox-VE-Server geantwortet."

#: authswitch/core.py:390
msgid "none"
msgstr "keine"

#: authswitch/core.py:391
#, python-brace-format
msgid "No account '{user}'. Known accounts: {known}"
msgstr "Kein Konto '{user}'. Bekannte Konten: {known}"

#: authswitch/core.py:393
#, python-brace-format
msgid "'{user}' is ambiguous; pass the full token ID and a hostname."
msgstr ""
"'{user}' ist nicht eindeutig; bitte vollständige Token-ID und Hostnamen "
"angeben."

#: authswitch/core.py:422
msgid "No Proxmox VE account is set up for this server."
msgstr "Für diesen Server ist kein Proxmox-VE-Konto eingerichtet."

#: authswitch/core.py:424
msgid "Several Proxmox VE servers are known; pass a hostname."
msgstr "Mehrere Proxmox-VE-Server sind bekannt; bitte Hostnamen angeben."

#: authswitch/core.py:431
#, python-brace-format
msgid "No secret for {token} in the system keyring; add the account again."
msgstr ""
"Kein Geheimnis für {token} im System-Schlüsselbund; bitte Konto erneut "
"hinzufügen."

#: authswitch/core.py:448
msgid "Read everything"
msgstr "Alles lesen"

#: authswitch/core.py:448
msgid "See guests, nodes, storage and settings without changing them"
msgstr "Gäste, Knoten, Speicher und Einstellungen sehen, ohne sie zu ändern"

#: authswitch/core.py:449
msgid ""
"Start, stop, open the console and back up virtual machines and containers"
msgstr ""
"Virtuelle Maschinen und Container starten, stoppen, die Konsole öffnen und "
"sichern"

#: authswitch/core.py:449
msgid "Use guests"
msgstr "Gäste benutzen"

#: authswitch/core.py:450
msgid "Create, configure, migrate and delete virtual machines and containers"
msgstr ""
"Virtuelle Maschinen und Container anlegen, konfigurieren, migrieren und "
"löschen"

#: authswitch/core.py:450
msgid "Manage guests"
msgstr "Gäste verwalten"

#: authswitch/core.py:451
msgid "Add storage, upload images and manage backups"
msgstr "Speicher hinzufügen, Images hochladen und Sicherungen verwalten"

#: authswitch/core.py:451
msgid "Manage storage"
msgstr "Speicher verwalten"

#: authswitch/core.py:452
msgid "Create resource pools and assign guests to them"
msgstr "Ressourcen-Pools anlegen und Gäste zuordnen"

#: authswitch/core.py:452
msgid "Manage pools"
msgstr "Pools verwalten"

#: authswitch/core.py:453
msgid "Create, change and delete users, groups and their API tokens"
msgstr "Benutzer, Gruppen und deren API-Tokens anlegen, ändern und löschen"

#: authswitch/core.py:453
msgid "Manage accounts"
msgstr "Konten verwalten"

#: authswitch/core.py:454
msgid "Configure software-defined networks (SDN)"
msgstr "Software-definierte Netzwerke (SDN) konfigurieren"

#: authswitch/core.py:454
msgid "Manage networks"
msgstr "Netzwerke verwalten"

#: authswitch/core.py:455
msgid "Administer nodes"
msgstr "Knoten administrieren"

#: authswitch/core.py:455
msgid "Node settings, network, updates and services"
msgstr "Knoteneinstellungen, Netzwerk, Updates und Dienste"

#: authswitch/core.py:456
msgid "Everything, including changing permissions"
msgstr "Alles, einschließlich Berechtigungen ändern"

#: authswitch/core.py:456
msgid "Full access"
msgstr "Vollzugriff"

#: authswitch/core.py:595
msgid ""
"The Administrator role could not be granted; privilege separation was left "
"off."
msgstr ""
"Die Rolle Administrator konnte nicht erteilt werden; die Privilegientrennung "
"bleibt aus."

#: authswitch/core.py:624
#, python-brace-format
msgid "Blocked for this account in Auth-Switch: {path}"
msgstr "Für dieses Konto in Auth-Switch gesperrt: {path}"

#: authswitch/core.py:691
#, python-brace-format
msgid "No node of {host} could be read."
msgstr "Kein Knoten von {host} konnte gelesen werden."

#: authswitch/core.py:773
msgid "ssh is not installed."
msgstr "ssh ist nicht installiert."

#: authswitch/core.py:781
#, python-brace-format
msgid "SSH to {host} timed out."
msgstr "SSH zu {host} hat zu lange gedauert."

#: authswitch/core.py:784
#, python-brace-format
msgid "SSH as root@{host} failed: {detail}"
msgstr "SSH als root@{host} fehlgeschlagen: {detail}"

#: authswitch/core.py:821
#, python-brace-format
msgid "Task on {node} failed: {status}"
msgstr "Task auf {node} fehlgeschlagen: {status}"

#: authswitch/core.py:824
#, python-brace-format
msgid "Task on {node} did not finish in time."
msgstr "Task auf {node} wurde nicht rechtzeitig fertig."

#: authswitch/gui.py:24
msgid ""
"The token lacks the right for this. A token with privilege separation only "
"has the rights granted to the token itself. For a management token of "
"root@pam, open Datacenter → Permissions → API Tokens in the web interface, "
"edit the token and untick \"Privilege Separation\"; otherwise grant it a "
"role with \"Permissions…\" from another account."
msgstr ""
"Dem Token fehlt dafür das Recht. Ein Token mit Privilegientrennung hat nur "
"die Rechte, die dem Token selbst erteilt wurden. Für ein Verwaltungs-Token "
"von root@pam öffne in der Weboberfläche Rechenzentrum → Berechtigungen → API-"
"Token, bearbeite das Token und entferne das Häkchen bei „Separierung der "
"Privilegien“; sonst erteile ihm von einem anderen Konto aus mit "
"„Berechtigungen …“ eine Rolle."

#: authswitch/gui.py:55 authswitch/gui.py:164 authswitch/gui.py:563
msgid "Add account"
msgstr "Konto hinzufügen"

#: authswitch/gui.py:58
msgid "Refresh"
msgstr "Aktualisieren"

#: authswitch/gui.py:60
msgid "About"
msgstr "Info"

#: authswitch/gui.py:75
msgid "Show"
msgstr "Anzeigen"

#: authswitch/gui.py:115 authswitch/gui.py:832
msgid "Close"
msgstr "Schließen"

#: authswitch/gui.py:122
msgid "Copied to clipboard"
msgstr "In die Zwischenablage kopiert"

#: authswitch/gui.py:134
msgid "Switch between Proxmox VE accounts"
msgstr "Zwischen Proxmox-VE-Konten wechseln"

#: authswitch/gui.py:162
msgid "No accounts yet"
msgstr "Noch keine Konten"

#: authswitch/gui.py:163
msgid "Add an API token of your Proxmox VE server to get started."
msgstr "Füge ein API-Token deines Proxmox-VE-Servers hinzu, um loszulegen."

#: authswitch/gui.py:187
msgid "Certificate confirmed by you"
msgstr "Zertifikat von dir bestätigt"

#: authswitch/gui.py:187
msgid "Certificate trusted by the system"
msgstr "Zertifikat vom System als vertrauenswürdig eingestuft"

#: authswitch/gui.py:189
msgid "Enterprise Repository"
msgstr "Enterprise-Repository"

#: authswitch/gui.py:190
msgid "No-Subscription Repository"
msgstr "No-Subscription-Repository"

#: authswitch/gui.py:191
msgid "No subscription – repository not set up"
msgstr "Kein Abonnement – Repository nicht eingerichtet"

#: authswitch/gui.py:196 authswitch/gui.py:224 authswitch/gui.py:509
msgid "Open web interface"
msgstr "Weboberfläche öffnen"

#: authswitch/gui.py:212
msgid "Switch"
msgstr "Wechseln"

#: authswitch/gui.py:221
msgid "Permissions…"
msgstr "Berechtigungen …"

#: authswitch/gui.py:222
msgid "Subscription and repository…"
msgstr "Abonnement und Repository …"

#: authswitch/gui.py:223
msgid "Updates and language…"
msgstr "Updates und Sprache …"

#: authswitch/gui.py:225
msgid "Enter secret again"
msgstr "Geheimnis erneut eingeben"

#: authswitch/gui.py:226 authswitch/gui.py:307
msgid "Remove"
msgstr "Entfernen"

#: authswitch/gui.py:232
msgid "Access to guests and storage"
msgstr "Zugriff auf Gäste und Speicher"

#: authswitch/gui.py:254
msgid "Checking token…"
msgstr "Token wird geprüft …"

#: authswitch/gui.py:260
msgid "Token invalid – enter the secret again"
msgstr "Token ungültig – Geheimnis erneut eingeben"

#: authswitch/gui.py:262
msgid "Enter again"
msgstr "Neu eingeben"

#: authswitch/gui.py:265
msgid "Server not reachable"
msgstr "Server nicht erreichbar"

#: authswitch/gui.py:267 authswitch/gui.py:802
#, python-brace-format
msgid "Proxmox VE {version}"
msgstr "Proxmox VE {version}"

#: authswitch/gui.py:269
msgid "No rights – check privilege separation"
msgstr "Keine Rechte – Privilegientrennung prüfen"

#: authswitch/gui.py:271
msgid "Active"
msgstr "Aktiv"

#: authswitch/gui.py:286
msgid "Switching failed"
msgstr "Wechsel fehlgeschlagen"

#: authswitch/gui.py:288
#, python-brace-format
msgid "Switched to {token}"
msgstr "Zu {token} gewechselt"

#: authswitch/gui.py:300
#, python-brace-format
msgid "Remove {token}?"
msgstr "{token} entfernen?"

#: authswitch/gui.py:302
#, python-brace-format
msgid ""
"The secret is deleted from the system keyring. The token itself stays valid "
"on {host}; revoke it in the web interface if you no longer need it."
msgstr ""
"Das Geheimnis wird aus dem System-Schlüsselbund gelöscht. Das Token selbst "
"bleibt auf {host} gültig; widerrufe es in der Weboberfläche, wenn du es "
"nicht mehr brauchst."

#: authswitch/gui.py:306 authswitch/gui.py:481 authswitch/gui.py:570
#: authswitch/gui.py:633 authswitch/gui.py:850
msgid "Cancel"
msgstr "Abbrechen"

#: authswitch/gui.py:312
msgid "Removing failed"
msgstr "Entfernen fehlgeschlagen"

#: authswitch/gui.py:314
#, python-brace-format
msgid "Removed {token}"
msgstr "{token} entfernt"

#: authswitch/gui.py:330
#, python-brace-format
msgid "Access for {token}"
msgstr "Zugriff für {token}"

#: authswitch/gui.py:332
msgid "Switched off means no access, even if broader rights would allow it."
msgstr ""
"Ausgeschaltet heißt kein Zugriff, auch wenn weiter gefasste Rechte ihn "
"erlauben würden."

#: authswitch/gui.py:338 authswitch/gui.py:464
msgid "Change with"
msgstr "Ändern mit"

#: authswitch/gui.py:344
msgid "Container"
msgstr "Container"

#: authswitch/gui.py:344
msgid "Node"
msgstr "Knoten"

#: authswitch/gui.py:344
msgid "Storage"
msgstr "Speicher"

#: authswitch/gui.py:344
msgid "Virtual machine"
msgstr "Virtuelle Maschine"

#: authswitch/gui.py:347
msgid "Enforce on the server"
msgstr "Auf dem Server durchsetzen"

#: authswitch/gui.py:348
msgid "Grants the token Administrator on / and turns on privilege separation"
msgstr ""
"Erteilt dem Token Administrator auf / und schaltet die Privilegientrennung "
"ein"

#: authswitch/gui.py:357
msgid "Blocks could not be enforced on the server"
msgstr "Sperren konnten auf dem Server nicht durchgesetzt werden"

#: authswitch/gui.py:359
#, python-brace-format
msgid "Blocks of {token} now apply to every access"
msgstr "Sperren von {token} gelten jetzt für jeden Zugriff"

#: authswitch/gui.py:380
msgid "Access could not be changed"
msgstr "Zugriff konnte nicht geändert werden"

#: authswitch/gui.py:382
#, python-brace-format
msgid "Access to {path} allowed"
msgstr "Zugriff auf {path} erlaubt"

#: authswitch/gui.py:382
#, python-brace-format
msgid "Access to {path} denied"
msgstr "Zugriff auf {path} verweigert"

#: authswitch/gui.py:402
msgid ""
"Without privilege separation the server does not enforce these blocks; only "
"the MCP server of Auth-Switch keeps to them."
msgstr ""
"Ohne Privilegientrennung setzt der Server diese Sperren nicht durch; nur der "
"MCP-Server von Auth-Switch hält sich daran."

#: authswitch/gui.py:416
msgid "No guests, storages or nodes are visible to the selected account."
msgstr ""
"Für das gewählte Konto sind keine Gäste, Speicher oder Knoten sichtbar."

#: authswitch/gui.py:419
msgid "Loading…"
msgstr "Wird geladen …"

#: authswitch/gui.py:445
msgid "Try again with another account of this server."
msgstr "Versuche es mit einem anderen Konto dieses Servers erneut."

#: authswitch/gui.py:446
msgid "Permissions could not be read"
msgstr "Berechtigungen konnten nicht gelesen werden"

#: authswitch/gui.py:470
#, python-brace-format
msgid ""
"Roles for {token} on the whole server (path /). Rights on other paths stay "
"as they are. Changing them needs an account with the right to modify "
"permissions, such as a token of root@pam."
msgstr ""
"Rollen für {token} auf dem ganzen Server (Pfad /). Rechte auf anderen Pfaden "
"bleiben unverändert. Zum Ändern braucht es ein Konto, das Berechtigungen "
"ändern darf, etwa ein Token von root@pam."

#: authswitch/gui.py:475
msgid ""
"This token has no privilege separation, so it holds all rights of its user "
"and these roles have no effect. Turn on privilege separation in the web "
"interface to limit it."
msgstr ""
"Dieses Token hat keine Privilegientrennung, es hat also alle Rechte seines "
"Benutzers, und diese Rollen wirken nicht. Schalte die Privilegientrennung in "
"der Weboberfläche ein, um es zu begrenzen."

#: authswitch/gui.py:479
msgid "Permissions"
msgstr "Berechtigungen"

#: authswitch/gui.py:482
msgid "Apply"
msgstr "Übernehmen"

#: authswitch/gui.py:487
msgid "Permissions could not be changed"
msgstr "Berechtigungen konnten nicht geändert werden"

#: authswitch/gui.py:489
#, python-brace-format
msgid "Permissions of {token} changed"
msgstr "Berechtigungen von {token} geändert"

#: authswitch/gui.py:506
msgid "Server address, e.g. pve.example.com"
msgstr "Serveradresse, z. B. pve.example.com"

#: authswitch/gui.py:507
msgid "API token ID, e.g. root@pam!auth-switch"
msgstr "API-Token-ID, z. B. root@pam!auth-switch"

#: authswitch/gui.py:508
msgid "Secret"
msgstr "Geheimnis"

#: authswitch/gui.py:513
msgid "Servers in your network"
msgstr "Server in deinem Netzwerk"

#: authswitch/gui.py:514
msgid "Search again"
msgstr "Erneut suchen"

#: authswitch/gui.py:535
msgid "(already added)"
msgstr "(bereits hinzugefügt)"

#: authswitch/gui.py:538
msgid "No Proxmox VE server found in your local networks"
msgstr "Kein Proxmox-VE-Server in deinen lokalen Netzen gefunden"

#: authswitch/gui.py:540
#, python-brace-format
msgid "{count} found"
msgstr "{count} gefunden"

#: authswitch/gui.py:549
msgid "Searching your local networks…"
msgstr "Lokale Netze werden durchsucht …"

#: authswitch/gui.py:565
msgid ""
"Create an API token in the web interface under Datacenter → Permissions → "
"API Tokens and copy its ID and secret. The secret is kept in the system "
"keyring only."
msgstr ""
"Erstelle in der Weboberfläche unter Rechenzentrum → Berechtigungen → API-"
"Token ein Token und kopiere ID und Geheimnis. Das Geheimnis liegt "
"ausschließlich im System-Schlüsselbund."

#: authswitch/gui.py:571
msgid "Add"
msgstr "Hinzufügen"

#: authswitch/gui.py:595 authswitch/gui.py:606
msgid "Adding failed"
msgstr "Hinzufügen fehlgeschlagen"

#: authswitch/gui.py:597
#, python-brace-format
msgid "Added {token}"
msgstr "{token} hinzugefügt"

#: authswitch/gui.py:622
#, python-brace-format
msgid ""
"The certificate of {host} is not signed by an authority your system trusts, "
"which is normal for Proxmox VE. Compare this SHA-256 fingerprint with the "
"one shown under Node → System → Certificates, or by 'pvenode cert info' on "
"the server. Only continue if they match."
msgstr ""
"Das Zertifikat von {host} ist nicht von einer Stelle signiert, der dein "
"System vertraut – bei Proxmox VE ist das normal. Vergleiche diesen SHA-256-"
"Fingerabdruck mit dem unter Knoten → System → Zertifikate oder mit der "
"Ausgabe von 'pvenode cert info' auf dem Server. Fahre nur fort, wenn sie "
"übereinstimmen."

#: authswitch/gui.py:627
msgid "Warning: this is not the certificate you confirmed before."
msgstr "Achtung: Das ist nicht das Zertifikat, das du vorher bestätigt hast."

#: authswitch/gui.py:631
msgid "Check the server certificate"
msgstr "Serverzertifikat prüfen"

#: authswitch/gui.py:634
msgid "Fingerprint matches"
msgstr "Fingerabdruck stimmt"

#: authswitch/gui.py:650
#, python-brace-format
msgid "{token} has no rights yet"
msgstr "{token} hat noch keine Rechte"

#: authswitch/gui.py:651
msgid "It can sign in, but may not read or change anything."
msgstr "Es kann sich anmelden, darf aber nichts lesen oder ändern."

#: authswitch/gui.py:663
msgid "Subscription could not be checked"
msgstr "Abonnement konnte nicht geprüft werden"

#: authswitch/gui.py:664
msgid ""
"Reading needs the right Sys.Audit on the nodes, changing it Sys.Modify, for "
"example with a token of root@pam."
msgstr ""
"Zum Lesen braucht es das Recht Sys.Audit auf den Knoten, zum Ändern Sys."
"Modify, zum Beispiel mit einem Token von root@pam."

#: authswitch/gui.py:674
#, python-brace-format
msgid "{host} has an active subscription and uses the enterprise repository"
msgstr "{host} hat ein aktives Abonnement und nutzt das Enterprise-Repository"

#: authswitch/gui.py:682
msgid "No valid subscription"
msgstr "Kein gültiges Abonnement"

#: authswitch/gui.py:684
#, python-brace-format
msgid ""
"{nodes} on {host} have no active subscription, but the enterprise repository "
"is still in use or the no-subscription repository is missing, so updates "
"fail. Auth-Switch can enable the no-subscription repository, also for Ceph, "
"and disable the enterprise repositories through the Proxmox VE API. This is "
"done with {token}."
msgstr ""
"{nodes} auf {host} haben kein aktives Abonnement, aber das Enterprise-"
"Repository ist noch aktiv oder das No-Subscription-Repository fehlt, daher "
"schlagen Updates fehl. Auth-Switch kann über die Proxmox-VE-API das No-"
"Subscription-Repository einschalten, auch für Ceph, und die Enterprise-"
"Repositories abschalten. Das geschieht mit {token}."

#: authswitch/gui.py:690 authswitch/gui.py:723
msgid "Not now"
msgstr "Nicht jetzt"

#: authswitch/gui.py:691
msgid "Set up"
msgstr "Einrichten"

#: authswitch/gui.py:696
msgid "Repositories could not be changed"
msgstr "Repositories konnten nicht geändert werden"

#: authswitch/gui.py:698
#, python-brace-format
msgid "{host} now uses the no-subscription repository"
msgstr "{host} nutzt jetzt das No-Subscription-Repository"

#: authswitch/gui.py:713
#, python-brace-format
msgid ""
"The web interface of {host} shows \"No valid subscription\" at every login. "
"Auth-Switch can hide it and install an APT hook that hides it again after "
"updates. This needs root on the node: either over SSH as root with your "
"existing keys – nothing is typed or stored here – or by pasting a command "
"into the node shell."
msgstr ""
"Die Weboberfläche von {host} zeigt bei jeder Anmeldung „No valid "
"subscription“. Auth-Switch kann den Hinweis ausblenden und einen APT-Hook "
"einrichten, der ihn nach Updates wieder ausblendet. Das braucht root auf dem "
"Knoten: entweder per SSH als root mit deinen vorhandenen Schlüsseln – hier "
"wird nichts eingegeben oder gespeichert – oder indem du einen Befehl in die "
"Node-Shell einfügst."

#: authswitch/gui.py:719
#, python-brace-format
msgid ""
"Only the node you connect to is changed; repeat it on {nodes} if you use "
"their web interface."
msgstr ""
"Geändert wird nur der Knoten, mit dem du verbunden bist; wiederhole es auf "
"{nodes}, falls du deren Weboberfläche nutzt."

#: authswitch/gui.py:722
msgid "Remove the subscription notice?"
msgstr "Abonnement-Hinweis entfernen?"

#: authswitch/gui.py:724
msgid "Copy command"
msgstr "Befehl kopieren"

