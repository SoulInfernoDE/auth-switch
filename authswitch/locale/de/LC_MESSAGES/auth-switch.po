#: authswitch/__main__.py:15
msgid "Switch between Proxmox VE accounts."
msgstr "Zwischen Proxmox-VE-Konten wechseln."

#: authswitch/__main__.py:18
msgid "open the window (default)"
msgstr "Fenster öffnen (Standard)"

#: authswitch/__main__.py:19
msgid "print the accounts as JSON"
msgstr "Konten als JSON ausgeben"

#: authswitch/__main__.py:20
msgid "activate an account"
msgstr "ein Konto aktivieren"

#: authswitch/__main__.py:23
msgid "run a command with the active account in its environment"
msgstr "einen Befehl mit dem aktiven Konto in seiner Umgebung ausführen"

#: authswitch/__main__.py:26
msgid "check files or a git working copy for private data"
msgstr "Dateien oder eine Git-Arbeitskopie auf private Daten prüfen"

#: authswitch/__main__.py:28
msgid "check what the next push of this working copy would publish"
msgstr "prüfen, was der nächste Push dieser Arbeitskopie veröffentlichen würde"

#: authswitch/__main__.py:29
msgid "run the MCP server on stdio"
msgstr "MCP-Server über stdio starten"

#: authswitch/__main__.py:40
msgid "exec needs a command, for example: auth-switch exec -- terraform plan"
msgstr ""
"exec braucht einen Befehl, zum Beispiel: auth-switch exec -- terraform plan"

#: authswitch/__main__.py:50
#, python-brace-format
msgid "auth-switch: {error}"
msgstr "auth-switch: {error}"

#: authswitch/__main__.py:68
msgid "No private data found."
msgstr "Keine privaten Daten gefunden."

#: authswitch/__main__.py:68
#, python-brace-format
msgid "{count} finding(s)."
msgstr "{count} Fund(e)."

#: authswitch/core.py:163
msgid ""
"No system keyring is available (libsecret is missing), so the secret cannot "
"be stored safely."
msgstr ""
"Kein System-Schlüsselbund verfügbar (libsecret fehlt), das Geheimnis kann "
"daher nicht sicher gespeichert werden."

#: authswitch/core.py:175
#, python-brace-format
msgid "The system keyring refused the request: {detail}"
msgstr "Der System-Schlüsselbund hat die Anfrage abgelehnt: {detail}"

#: authswitch/core.py:186 authswitch/sshaccess.py:56
msgid "The secret could not be stored in the system keyring."
msgstr "Das Geheimnis konnte nicht im System-Schlüsselbund gespeichert werden."

#: authswitch/core.py:217 authswitch/core.py:231 authswitch/core.py:328
#: authswitch/core.py:785 authswitch/rootshell.py:48
#, python-brace-format
msgid "{host} cannot be reached: {detail}"
msgstr "{host} ist nicht erreichbar: {detail}"

#: authswitch/core.py:257
#, python-brace-format
msgid ""
"The certificate of {host} is not the one you confirmed. Nothing was sent. If "
"the server got a new certificate, add the account again to confirm it."
msgstr ""
"Das Zertifikat von {host} ist nicht das, das du bestätigt hast. Es wurde "
"nichts gesendet. Falls der Server ein neues Zertifikat hat, füge das Konto "
"erneut hinzu, um es zu bestätigen."

#: authswitch/core.py:288
msgid "The path must start with a single / and stay below /api2/json."
msgstr ""
"Der Pfad muss mit genau einem / beginnen und unterhalb von /api2/json "
"bleiben."

#: authswitch/core.py:290
msgid "Endpoints that issue tickets or credentials are not available here."
msgstr ""
"Endpunkte, die Tickets oder Zugangsdaten ausstellen, stehen hier nicht zur "
"Verfügung."

#: authswitch/core.py:305 authswitch/mcp.py:174
#, python-brace-format
msgid "Unsupported method: {method}"
msgstr "Nicht unterstützte Methode: {method}"

#: authswitch/core.py:325
#, python-brace-format
msgid ""
"The certificate of {host} is not trusted; add the account again to confirm "
"it."
msgstr ""
"Dem Zertifikat von {host} wird nicht vertraut; füge das Konto erneut hinzu, "
"um es zu bestätigen."

#: authswitch/core.py:371
msgid ""
"The token ID must look like user@realm!name, for example root@pam!auth-"
"switch."
msgstr ""
"Die Token-ID muss die Form benutzer@realm!name haben, zum Beispiel root@pam!"
"auth-switch."

#: authswitch/core.py:374
#, python-brace-format
msgid "{host} rejected the token."
msgstr "{host} hat das Token abgelehnt."

#: authswitch/core.py:376
#, python-brace-format
msgid "{host} did not answer like a Proxmox VE server."
msgstr "{host} hat nicht wie ein Proxmox-VE-Server geantwortet."

#: authswitch/core.py:399
msgid "none"
msgstr "keine"

#: authswitch/core.py:400
#, python-brace-format
msgid "No account '{user}'. Known accounts: {known}"
msgstr "Kein Konto '{user}'. Bekannte Konten: {known}"

#: authswitch/core.py:402
#, python-brace-format
msgid "'{user}' is ambiguous; pass the full token ID and a hostname."
msgstr ""
"'{user}' ist nicht eindeutig; bitte vollständige Token-ID und Hostnamen "
"angeben."

#: authswitch/core.py:431
msgid "No Proxmox VE account is set up for this server."
msgstr "Für diesen Server ist kein Proxmox-VE-Konto eingerichtet."

#: authswitch/core.py:433
msgid "Several Proxmox VE servers are known; pass a hostname."
msgstr "Mehrere Proxmox-VE-Server sind bekannt; bitte Hostnamen angeben."

#: authswitch/core.py:440
#, python-brace-format
msgid "No secret for {token} in the system keyring; add the account again."
msgstr ""
"Kein Geheimnis für {token} im System-Schlüsselbund; bitte Konto erneut "
"hinzufügen."

#: authswitch/core.py:457
msgid "Read everything"
msgstr "Alles lesen"

#: authswitch/core.py:457
msgid "See guests, nodes, storage and settings without changing them"
msgstr "Gäste, Knoten, Speicher und Einstellungen sehen, ohne sie zu ändern"

#: authswitch/core.py:458
msgid ""
"Start, stop, open the console and back up virtual machines and containers"
msgstr ""
"Virtuelle Maschinen und Container starten, stoppen, die Konsole öffnen und "
"sichern"

#: authswitch/core.py:458
msgid "Use guests"
msgstr "Gäste benutzen"

#: authswitch/core.py:459
msgid "Create, configure, migrate and delete virtual machines and containers"
msgstr ""
"Virtuelle Maschinen und Container anlegen, konfigurieren, migrieren und "
"löschen"

#: authswitch/core.py:459
msgid "Manage guests"
msgstr "Gäste verwalten"

#: authswitch/core.py:460
msgid "Add storage, upload images and manage backups"
msgstr "Speicher hinzufügen, Images hochladen und Sicherungen verwalten"

#: authswitch/core.py:460
msgid "Manage storage"
msgstr "Speicher verwalten"

#: authswitch/core.py:461
msgid "Create resource pools and assign guests to them"
msgstr "Ressourcen-Pools anlegen und Gäste zuordnen"

#: authswitch/core.py:461
msgid "Manage pools"
msgstr "Pools verwalten"

#: authswitch/core.py:462
msgid "Create, change and delete users, groups and their API tokens"
msgstr "Benutzer, Gruppen und deren API-Tokens anlegen, ändern und löschen"

#: authswitch/core.py:462
msgid "Manage accounts"
msgstr "Konten verwalten"

#: authswitch/core.py:463
msgid "Configure software-defined networks (SDN)"
msgstr "Software-definierte Netzwerke (SDN) konfigurieren"

#: authswitch/core.py:463
msgid "Manage networks"
msgstr "Netzwerke verwalten"

#: authswitch/core.py:464
msgid "Administer nodes"
msgstr "Knoten administrieren"

#: authswitch/core.py:464
msgid "Node settings, network, updates and services"
msgstr "Knoteneinstellungen, Netzwerk, Updates und Dienste"

#: authswitch/core.py:465
msgid "Everything, including changing permissions"
msgstr "Alles, einschließlich Berechtigungen ändern"

#: authswitch/core.py:465
msgid "Full access"
msgstr "Vollzugriff"

#: authswitch/core.py:605
msgid ""
"The Administrator role could not be granted; privilege separation was left "
"off."
msgstr ""
"Die Rolle Administrator konnte nicht erteilt werden; die Privilegientrennung "
"bleibt aus."

#: authswitch/core.py:634
#, python-brace-format
msgid "Blocked for this account in Auth-Switch: {path}"
msgstr "Für dieses Konto in Auth-Switch gesperrt: {path}"

#: authswitch/core.py:701
#, python-brace-format
msgid "No node of {host} could be read."
msgstr "Kein Knoten von {host} konnte gelesen werden."

