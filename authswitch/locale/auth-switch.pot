#: authswitch/mcp.py:48
msgid ""
"Read from the Proxmox VE API as the active account. The path is relative to /"
"api2/json, for example /cluster/resources?type=vm, /nodes, /nodes/NODE/"
"qemu, /nodes/NODE/lxc/VMID/status/current, /nodes/NODE/storage or /cluster/"
"tasks. Endpoints that issue tickets or credentials are blocked."
msgstr ""

#: authswitch/mcp.py:55 authswitch/mcp.py:77
msgid "API path below /api2/json, starting with /"
msgstr ""

#: authswitch/mcp.py:56
msgid "Query parameters"
msgstr ""

#: authswitch/mcp.py:67
msgid ""
"Change something through the Proxmox VE API as the active account, for "
"example start or stop a guest (POST /nodes/NODE/qemu/VMID/status/start), "
"create a snapshot (POST /nodes/NODE/qemu/VMID/snapshot) or change a "
"configuration (PUT /nodes/NODE/qemu/VMID/config). The path is relative to /"
"api2/json; parameters are sent as form fields. Many calls return a task ID "
"(UPID) whose progress can be read at /nodes/NODE/tasks/UPID/status. DELETE "
"removes data permanently."
msgstr ""

#: authswitch/mcp.py:78
msgid "Parameters of the call"
msgstr ""

#: authswitch/mcp.py:89
msgid ""
"Check content for private data before it is published: secrets of the "
"Proxmox VE accounts, other access tokens and private keys, addresses of the "
"user's Proxmox servers, the real git e-mail address, paths in the home "
"directory, the computer name and internal network addresses. Call it before "
"committing, pushing, creating a release, opening an issue or pull request, "
"or putting text into a README. Pass 'repository' to check what the next push "
"would publish, 'paths' for files or folders, or 'text' for a draft. Findings "
"of severity 'secret' must be removed; discuss 'private' and 'review' "
"findings with the user instead of publishing them."
msgstr ""

